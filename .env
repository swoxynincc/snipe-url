# Never commit your real .env file.
DISCORD_TOKEN=your_bot_token_here

# Guild whose current vanity URL you are authorized to monitor.
GUILD_ID=1545503087370829847

# Channel where change notifications should be posted.
NOTIFICATION_CHANNEL_ID=1545503088159232152

# Conservative polling interval.
POLL_INTERVAL_MS=300000

# Maximum delay after transient failures.
MAX_BACKOFF_MS=3600000
